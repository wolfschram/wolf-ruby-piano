{
  "name": "wolf-ruby-piano",
  "version": "1.0.0",
  "description": "Piano learning app with Wolf Mode (adult visual learner) and Ruby Mode (5-year-old beginner)",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ electron/"
  },
  "keywords": [
    "piano",
    "midi",
    "learning",
    "electron",
    "music"
  ],
  "author": "Wolfgang Schram",
  "license": "MIT",
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^10.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.wolfschram.wolfrubyPiano",
    "productName": "Wolf & Ruby Piano",
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
